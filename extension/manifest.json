{
  "manifest_version": 3,
  "name": "CIPHER//NET",
  "version": "1.0.0",
  "description": "Self-hosted, end-to-end encrypted chat. No servers, no accounts. Opens CIPHER//NET in a tab — fully offline, all crypto local.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CIPHER//NET",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ciphernet@retiredroca"
    }
  }
}